    {
      "id": "code_build_next_msg",
      "name": "Code: Build Next Msg",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3856,
        320
      ],
      "parameters": {
        "jsCode": "const checkData = $('Code: Check Next Entry').first().json;\nconst manager = $input.first().json;\nconst volunteer = $('HTTP: GET Volunteer').first().json;\n\nconst mgrJid = (manager.phone || '').replace(/[^0-9]/g, '') + '@s.whatsapp.net';\nconst volunteer_name = volunteer.first_name + ' ' + volunteer.last_name;\n\nconst d = new Date(checkData.work_date + 'T12:00:00Z');\nconst dateStr = `${d.getUTCDate()}. ${d.getUTCMonth()+1}. ${d.getUTCFullYear()}`;\nconst queueInfo = checkData.unnotified_count > 1 ? `\\n\\nV vrsti: ${checkData.unnotified_count - 1} vnos(ov)` : '';\n\nconst mgrMsg = `Nov vnos čaka na odobritev:\\n\\n👤 ${volunteer_name}\\n📅 ${dateStr} — ${checkData.hours} ur\\n📝 ${checkData.activity_description}\\n📍 ${checkData.location || 'ni navedeno'}${queueInfo}\\n\\n1 - Odobri\\n2 - Zavrni`;\n\nreturn [{json: {phone: mgrJid, text: mgrMsg}}];"
      }
