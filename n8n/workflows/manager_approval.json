                  {
                      "id":  "code_vol_msg",
                      "name":  "Code: Build Volunteer Msg",
                      "parameters":  {
                                         "jsCode":  "// $input is the API response from approve/reject — use payload for action info\nconst payload = $(\u0027Code: Parse Action\u0027).first().json;\nconst isApproved = payload.action === \u0027odobri\u0027;\n\nlet volMsg;\nif (isApproved) {\n  volMsg = \\Vaš vnos z dne ${payload.entry_date} je bil odobren. ✅\n📝 ${payload.activity_description}, ${payload.hours} ur\\;\n} else {\n  volMsg = \\Vaš vnos z dne ${payload.entry_date} je bil zavrnjen. ❌\nUpravljalec vas bo kontaktiral za podrobnosti.\\;\n}\n\nreturn [{\n  json: {\n    ...payload,\n    action: isApproved ? \u0027approved\u0027 : \u0027rejected\u0027,\n    volMsg,\n    volunteerJid: payload.volunteer_remoteJid\n  }\n}];"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "position":  [
                                       1280,
                                       400
                                   ],
                      "typeVersion":  2
