          "jsCode": "// $input is the API response from approve/reject — use payload for action info\nconst payload = $('Code: Parse Action').first().json;\nconst isApproved = payload.action === 'odobri';\n\nlet volMsg;\nif (isApproved) {\n  volMsg = `Vaš vnos z dne ${payload.work_date} je bil odobren. ✅\\n📝 ${payload.activity_description}, ${payload.hours} ur`;\n} else {\n  volMsg = `Vaš vnos z dne ${payload.work_date} je bil zavrnjen. ❌\\nUpravljalec vas bo kontaktiral za podrobnosti.`;\n}\n\nreturn [{\n  json: {\n    ...payload,\n    action: isApproved ? 'approved' : 'rejected',\n    volMsg,\n    volunteerJid: payload.volunteer_remoteJid\n  }\n}];"
