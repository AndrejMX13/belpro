          "jsCode": "// Fetch Config sits upstream for instance_name; read entry data from the trigger directly\nconst data = $('Execute Workflow Trigger').isExecuted\n    ? $('Execute Workflow Trigger').first().json\n    : $('Manual Trigger').first().json;\n\nconst entry_id = data.entry_id;\nconst action = data.action || '';\n\nconst payload = {\n  entry_id,\n  action,\n  manager_phone: data.manager_phone || '',\n  manager_remoteJid: data.manager_remoteJid || '',\n  volunteer_name: data.volunteer_name || '',\n  volunteer_remoteJid: data.volunteer_remoteJid || '',\n  work_date: data.work_date || '',\n  hours: data.hours || 0,\n  activity_description: data.activity_description || '',\n  location: data.location || ''\n};\n\nif (!entry_id || !action) {\n  throw new Error('Missing required fields: entry_id and action');\n}\n\nreturn [{json: payload}];"
        },
