        "parameters": {
          "jsCode": "const response = $input.first().json;\nconst items = response.items || [];\n\nconst alreadyNotified = items.filter(e => e.manager_notified_at);\nif (alreadyNotified.length > 0) {\n  return [{json: {shouldNotify: false, reason: 'already_notified'}}];\n}\n\nconst unnotified = items.filter(e => !e.manager_notified_at);\nif (unnotified.length === 0) {\n  return [{json: {shouldNotify: false, reason: 'no_entries'}}];\n}\n\nconst entry = unnotified[0];\nreturn [{\n  json: {\n    shouldNotify: true,\n    entry_id: entry.id,\n    volunteer_id: entry.volunteer_id,\n    work_date: entry.work_date,\n    hours: entry.hours,\n    activity_description: entry.activity_description || '',\n    location: entry.location || '',\n    unnotified_count: unnotified.length\n  }\n}];"
        }
