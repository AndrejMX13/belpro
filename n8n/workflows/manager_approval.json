                  {
                      "id":  "code_parse_action",
                      "name":  "Code: Parse Action",
                      "parameters":  {
                                         "jsCode":  "const data = $input.first().json;\n\nconst entry_id = data.entry_id;\nconst action = data.action || \u0027\u0027;\n\nconst payload = {\n  entry_id,\n  action,\n  manager_phone: data.manager_phone || \u0027\u0027,\n  manager_remoteJid: data.manager_remoteJid || \u0027\u0027,\n  volunteer_name: data.volunteer_name || \u0027\u0027,\n  volunteer_remoteJid: data.volunteer_remoteJid || \u0027\u0027,\n  entry_date: data.entry_date || \u0027\u0027,\n  hours: data.hours || 0,\n  activity_description: data.activity_description || \u0027\u0027,\n  location: data.location || \u0027\u0027\n};\n\nif (!entry_id || !action) {\n  throw new Error(\u0027Missing required fields: entry_id and action\u0027);\n}\n\nreturn [{json: payload}];"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "position":  [
                                       500,
                                       400
                                   ],
                      "typeVersion":  2
                  },
