        "jsCode": "const payload = $('Code: Parse Action').first().json;\nconst actionLabel = payload.action === 'odobri' ? 'odobren' : 'zavrnjen';\nconst mgrMsg = `Vnos za ${payload.volunteer_name} je bil ${actionLabel}.`;\n\nreturn [{\n  json: {\n    managerJid: payload.manager_remoteJid,\n    mgrMsg\n  }\n}];"
