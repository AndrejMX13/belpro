      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/errors",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {service: $json.service, operation: $json.operation, message: $json.message, detail: $json.detail || null} }}"
      },
      "credentials": {
