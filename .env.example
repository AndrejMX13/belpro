# =============================================================================
# Belpro — .env.example
# Copy this file to .env and fill in all values before starting containers.
# .env is gitignored — never commit it.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# Single instance, three logical databases: belpro, n8n (schema), evolution
# -----------------------------------------------------------------------------
POSTGRES_DB=belpro
POSTGRES_USER=belpro
POSTGRES_PASSWORD=change_me_strong_password

# Full async DSN used by FastAPI / SQLAlchemy
DATABASE_URL=postgresql+asyncpg://belpro:change_me_strong_password@postgres:5432/belpro

# -----------------------------------------------------------------------------
# Encryption
# EMSO_ENCRYPTION_KEY: 32-byte key, base64url encoded.
# Generate with: python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# -----------------------------------------------------------------------------
EMSO_ENCRYPTION_KEY=GENERATE_AND_PASTE_HERE

# -----------------------------------------------------------------------------
# FastAPI
# API_SECRET_KEY: used for session signing / JWT if added later.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# MANAGER_PASSWORD: bootstrap login password for the web dashboard.
#   This is the password used on first login and until the manager changes
#   their password via the Settings page.  Once changed via the UI, the
#   hashed password stored in the database takes precedence — changing this
#   value and restarting will NOT reset the login.
#
#   Recovery if locked out (forgotten password after UI change):
#     docker compose exec postgres psql -U belpro -d belpro \
#       -c "UPDATE managers SET password_hash = NULL;"
#   This clears the DB hash and falls back to MANAGER_PASSWORD again.
# -----------------------------------------------------------------------------
API_SECRET_KEY=GENERATE_AND_PASTE_HERE
MANAGER_PASSWORD=change_me_strong_password

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password

# Webhook URL must be reachable by Evolution API (use localhost for local dev)
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PROTOCOL=http

# n8n API key — generated in n8n UI after first run (Settings → API)
# Also add to .mcp.json after generating
N8N_API_KEY=FILL_IN_AFTER_FIRST_N8N_RUN

# -----------------------------------------------------------------------------
# Evolution API (WhatsApp gateway)
# EVOLUTION_API_KEY: your chosen API key to secure the Evolution API.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
# -----------------------------------------------------------------------------
EVOLUTION_API_KEY=GENERATE_AND_PASTE_HERE
EVOLUTION_INSTANCE_NAME=belpro
EVOLUTION_SERVER_URL=http://localhost:8180

# -----------------------------------------------------------------------------
# Faster-Whisper
# WHISPER_MODEL: tiny/base/small/medium/large-v3
#   medium = good balance of speed vs accuracy for Slovenian dialects
#   large-v3 = best accuracy, ~4GB RAM, slower on CPU
# -----------------------------------------------------------------------------
WHISPER_MODEL=medium
WHISPER_LANGUAGE=sl

# -----------------------------------------------------------------------------
# Gmail (outgoing email — monthly PDFs, notifications)
# Use a Gmail App Password, not your main account password.
# Generate at: https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
GMAIL_ADDRESS=your_ngo@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
