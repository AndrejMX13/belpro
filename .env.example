# ============================================================
# Belpro — Environment Configuration
# Copy this file to .env and fill in every CHANGE_ME value.
# .env is gitignored — never commit it.
# ============================================================

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=belpro
POSTGRES_USER=belpro
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# FastAPI connection string (asyncpg driver).
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql+asyncpg://belpro:CHANGE_ME_strong_password@postgres:5432/belpro

# ─────────────────────────────────────────────────────────────
# Encryption — EMŠO stored AES-256 encrypted at rest
# ─────────────────────────────────────────────────────────────
# 32-byte key, base64-encoded. Generate once and back up securely:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
EMSO_ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key

# ─────────────────────────────────────────────────────────────
# n8n
# ─────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password

# Hostname n8n is served on (used to build webhook URLs).
# Local dev: localhost. Production: your public domain.
N8N_HOST=localhost
N8N_PROTOCOL=http

# Full base URL n8n advertises to callers (Evolution API → n8n webhooks).
# Local dev: http://localhost:5678/
# Production: https://n8n.example.org/
N8N_WEBHOOK_URL=http://localhost:5678/

# ─────────────────────────────────────────────────────────────
# Evolution API (WhatsApp gateway)
# ─────────────────────────────────────────────────────────────
# Long random string — use as the API key for all Evolution API calls.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
EVOLUTION_API_KEY=CHANGE_ME_evolution_api_key

# WhatsApp instance name created in Evolution API.
EVOLUTION_INSTANCE_NAME=belpro

# Public URL of the Evolution API server.
# Local dev: http://localhost:8080
# Production: https://wa.example.org
EVOLUTION_SERVER_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────
# Faster-Whisper (speech-to-text)
# ─────────────────────────────────────────────────────────────
# tiny | base | small | medium | large-v3
# medium strikes the best CPU accuracy/speed balance for Slovenian.
# large-v3 is more accurate but ~3× slower on CPU.
WHISPER_MODEL=medium
WHISPER_LANGUAGE=sl

# ─────────────────────────────────────────────────────────────
# FastAPI
# ─────────────────────────────────────────────────────────────
# Used to sign JWTs / session tokens. Generate once:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=CHANGE_ME_secret_key

# Single manager password for the web dashboard (v1 has no user table).
MANAGER_PASSWORD=CHANGE_ME_manager_password

# ─────────────────────────────────────────────────────────────
# Gmail (outgoing email — monthly PDFs, notifications)
# ─────────────────────────────────────────────────────────────
GMAIL_ADDRESS=your.ngo@gmail.com

# Use a Gmail App Password — NOT your Google account password.
# Requires 2FA enabled on the account.
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=CHANGE_ME_16_char_app_password

# ─────────────────────────────────────────────────────────────
# NGO identity (used in PDF reports and manager profile defaults)
# ─────────────────────────────────────────────────────────────
NGO_NAME=
NGO_ADDRESS=
